#  development | staging | production -------------------------
APP_ENV=development

# --- server -------------------------------------------------------------------
APP_SERVER_PORT=5005
APP_SERVER_DOMAIN=localhost
APP_SERVER_APIBASEPATH=/api/v1
# در production حتماً روی false بماند تا کوکی فقط روی HTTPS ارسال شود
APP_SERVER_INSECURECOOKIES=true

# --- سیاست دسترسی مسیرها: enterprise | public ---------------------------
#   enterprise = هر مسیری احراز هویت می‌خواهد (پیش‌فرض)
#   public     = بخشی عمومی، بخشی محافظت‌شده
# راهنما: docs/auth-flow.md
APP_AUTH_POSTURE=enterprise

# --- مجوزدهی: roles | rules | both --------------------------------------
# راهنما: docs/authorization.md
APP_AUTHZ_MODE=both
# ⚠️ در production باید true باشد؛ وگرنه دسترسی‌ها فقط ظاهری‌اند.
APP_AUTHZ_ENFORCE=true

# --- ماژول اختیاری OTP --------------------------------------------------
# راهنما: docs/optional-services/otp-auth.md
APP_OTP_ENABLED=false

# --- PostgreSQL -------------------------------------------------------------
APP_POSTGRES_HOST=localhost
APP_POSTGRES_PORT=5432
APP_POSTGRES_USER=postgres
APP_POSTGRES_PASSWORD=CHANGE_ME
APP_POSTGRES_DBNAME=goclean
# در production باید require یا verify-full باشد
APP_POSTGRES_SSLMODE=disable

# --- Redis ------------------------------------------------------------------
APP_REDIS_HOST=localhost
APP_REDIS_PORT=6379
APP_REDIS_PASSWORD=CHANGE_ME

# --- JWT --------------------------------------------------------------------
APP_JWT_ACCESSSECRET=CHANGE_ME_openssl_rand_base64_48
APP_JWT_REFRESHSECRET=CHANGE_ME_DIFFERENT_openssl_rand_base64_48

# --- CORS -------------------------------------------------------------------
APP_CORS_ALLOWORIGINS=http://localhost:3000
